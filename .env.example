# Variaveis do deploy (docker compose). Copie para .env no servidor.
#
# Dominio publico pelo qual o site e acessado. Sem isso o CORS bloqueia o
# login com "Origem nao autorizada".
FRONTEND_ORIGIN=https://davi.kevyn.com.br

# Precisa ter no minimo 32 caracteres em producao. Gere com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-uma-chave-gerada-aleatoriamente
