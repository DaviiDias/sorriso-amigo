PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sorriso_amigo
DATABASE_SSL=false

# Em producao precisa ter no minimo 32 caracteres (o servidor recusa subir se for menor).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-esta-chave-por-uma-segura

# Origens liberadas no CORS, separadas por virgula. Obrigatorio em producao.
FRONTEND_ORIGIN=https://davi.kevyn.com.br/,http://localhost:4000

NODE_ENV=development

# true faz o backend ignorar o login e tratar todo mundo como "Visitante".
# Use apenas para ajustar layout local. O servidor recusa subir com true em producao.
PUBLIC_ACCESS_MODE=false

# SMS: "console" apenas loga o codigo no terminal; "twilio" envia de verdade.
SMS_PROVIDER=console
SMS_CODE_TTL_MINUTES=10
SMS_CODE_MAX_ATTEMPTS=5

# Retorna o codigo de verificacao na resposta da API (apenas para desenvolvimento).
# O servidor recusa subir com true em producao.
SMS_EXPOSE_CODE=true

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
